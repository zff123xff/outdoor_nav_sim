# Dependency-only build context: never send the workspace, native installs,
# vendored binary deps, models, credentials or logs to the Docker daemon.
**
!docker/
!docker/**
!simulation/
!simulation/src/
!simulation/src/sim_*/
!simulation/src/sim_*/package.xml
!simulation/src/third_party/
!simulation/src/third_party/champ/
!simulation/src/third_party/champ/*/
!simulation/src/third_party/champ/*/package.xml
!commands/
!commands/src/
!commands/src/msg_set_msgs/
!commands/src/msg_set_msgs/package.xml
!commands/src/execute_task_server/
!commands/src/execute_task_server/package.xml
!commands/src/multi_goal_to_gp_goal/
!commands/src/multi_goal_to_gp_goal/package.xml
!commands/src/multi_task_bridge/
!commands/src/multi_task_bridge/package.xml
!commands/src/outdoor_nav_mqtt_sim/
!commands/src/outdoor_nav_mqtt_sim/package.xml
