  </link>
  <joint name="RR_foot_motor_joint" type="fixed">
    <origin xyz="0.00 -0.01 -0.2264" rpy="0 0.0 0" />
    <parent link="RR_calf" />
    <child link="RR_foot_motor" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="RR_foot">
    <inertial>
      <origin xyz="0 -0.06 0" rpy="0 0 0" />
      <mass value="0.520" />
      <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0007" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://go2w_sim/meshes/right_wheel.dae" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 -0.0481 0" />
      <geometry>
        <cylinder radius="0.086" length="0.0518" />
      </geometry>
    </collision>
  </link>
  <joint name="RR_foot_joint" type="continuous">
    <origin xyz="-0.0 0 -0.2264" rpy="0 0 0" />
    <parent link="RR_calf" />
    <child link="RR_foot" />
    <axis xyz="0 1 0" />
    <limit effort="23.7" velocity="30.1" />
  </joint>
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="-0.02557 0 0.04232" rpy="0 0 0" />
    <parent link="go2w_body" />
    <child link="imu_link" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="radar">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
  </link>
  <joint name="radar_joint" type="fixed">
    <origin xyz="0.28945 0 -0.046825" rpy="0 2.8782 0" />
    <parent link="go2w_body" />
    <child link="radar" />
    <axis xyz="0 0 0" />
  </joint>
  <xacro:arg name="robot_namespace" default="robot" />
  <xacro:arg name="leg_command_interface" default="position" />
  <xacro:arg name="wheel_mu1" default="0.4" />
  <xacro:arg name="wheel_mu2" default="0.02" />
  <xacro:arg name="imu_frequency" default="200" />
  <xacro:arg name="lidar_min_range" default="0.1" />
  <xacro:arg name="zny_interface" default="false" />
  <xacro:arg name="lidar_max_range" default="70" />
  <xacro:arg name="lidar_resolution" default="0.01" />
  <xacro:arg name="lidar_noise_stddev" default="0.02" />
  <xacro:arg name="lidar_vertical_min" default="-0.12217304764" />
  <xacro:arg name="lidar_vertical_max" default="0.90757121104" />
  <xacro:arg name="lidar_publish_rate" default="10" />
  <xacro:arg name="lidar_sensor_update_rate" default="$(arg lidar_publish_rate)" />
  <!-- Match outdoor_nav real-robot base_link->livox_frame xyz=(0.18,0,0.53).
       go2w_body is 0.43582611 m above the navigation base_link. -->
  <xacro:arg name="lidar_xyz" default="0.18 0 0.09417389" />
  <xacro:arg name="lidar_rpy" default="0 0.31415926536 0" />
  <xacro:property name="lidar_mount_xyz" value="$(arg lidar_xyz)" />
  <xacro:property name="lidar_support_height" value="${float(lidar_mount_xyz.split()[2]) - 0.094}" />
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="go2w_body" />
    <child link="lidar_mount_link" />
    <origin xyz="${float(lidar_mount_xyz.split()[0])} ${float(lidar_mount_xyz.split()[1])} ${0.080 + lidar_support_height / 2.0}" rpy="0 0 0" />
  </joint>
  <link name="lidar_mount_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="${0.05 * (3.0 * 0.012**2 + lidar_support_height**2) / 12.0}" ixy="0" ixz="0" iyy="${0.05 * (3.0 * 0.012**2 + lidar_support_height**2) / 12.0}" iyz="0" izz="0.0000036" />
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.012" length="${lidar_support_height}" />
      </geometry>
      <material name="lidar_mount_gray">
        <color rgba="0.25 0.25 0.25 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.012" length="${lidar_support_height}" />
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="go2w_body" />
    <child link="livox_frame" />
    <origin xyz="$(arg lidar_xyz)" rpy="$(arg lidar_rpy)" />
  </joint>
  <link name="livox_frame">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004" />
    </inertial>
    <visual>
      <!-- Metre-sized MID360 housing; optical-frame offset follows the existing
           mid360_simulation visual definition, not a measured robot mount. -->
      <origin xyz="0 0 -0.045" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://go2w_sim/meshes/mid360.STL" />
      </geometry>
      <material name="lidar_black">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.04" />
      </geometry>
    </collision>
  </link>
  <ros2_control name="Go2WGazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="FL_hip_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FL_thigh_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">0.67</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FL_calf_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">-1.3</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FL_foot_joint">
      <command_interface name="velocity" />
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FR_hip_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FR_thigh_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">0.67</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FR_calf_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">-1.3</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="FR_foot_joint">
      <command_interface name="velocity" />
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="RL_hip_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="RL_thigh_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">0.67</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="RL_calf_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">-1.3</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="RL_foot_joint">
      <command_interface name="velocity" />
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="RR_hip_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="RR_thigh_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">0.67</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="RR_calf_joint">
      <command_interface name="$(arg leg_command_interface)" />
      <state_interface name="position">
        <param name="initial_value">-1.3</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="RR_foot_joint">
      <command_interface name="velocity" />
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  <gazebo reference="FL_foot">
    <mu1>$(arg wheel_mu1)</mu1>
    <mu2>$(arg wheel_mu2)</mu2>
  </gazebo>
  <gazebo reference="FR_foot">
    <mu1>$(arg wheel_mu1)</mu1>
    <mu2>$(arg wheel_mu2)</mu2>
  </gazebo>
  <gazebo reference="RL_foot">
    <mu1>$(arg wheel_mu1)</mu1>
    <mu2>$(arg wheel_mu2)</mu2>
  </gazebo>
  <gazebo reference="RR_foot">
    <mu1>$(arg wheel_mu1)</mu1>
    <mu2>$(arg wheel_mu2)</mu2>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>__GO2W_CONTROLLERS_YAML__</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <ros>
        <remapping>diff_drive_controller/cmd_vel_unstamped:=__GO2W_CMD_VEL__</remapping>
      </ros>
    </plugin>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="native_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>$(arg imu_frequency)</update_rate>
      <!-- gazebo_ros_imu_sensor queries all six noise models at load time.
           Explicit zero variance preserves the existing noise-free behavior. -->
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="native_imu_ros">
        <ros>
          <namespace>/$(arg robot_namespace)</namespace>
          <remapping>~/out:=livox/imu</remapping>
        </ros>
        <frame_name>$(arg robot_namespace)/imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="livox_frame">
    <sensor name="mid360" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>$(arg lidar_sensor_update_rate)</update_rate>
      <plugin name="mid360_ros" filename="libmid360_plugin.so">
        <zny_interface>$(arg zny_interface)</zny_interface>
        <ros>
          <namespace>/$(arg robot_namespace)</namespace>
        </ros>
        <frame_name>$(arg robot_namespace)/livox_frame</frame_name>
        <ray>
          <scan>
            <horizontal>
              <samples>10</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28318530718</max_angle>
            </horizontal>
            <vertical>
              <samples>10</samples>
              <resolution>1</resolution>
              <min_angle>$(arg lidar_vertical_min)</min_angle>
              <max_angle>$(arg lidar_vertical_max)</max_angle>
            </vertical>
          </scan>
          <range>
            <min>$(arg lidar_min_range)</min>
            <max>$(arg lidar_max_range)</max>
            <resolution>$(arg lidar_resolution)</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>$(arg lidar_noise_stddev)</stddev>
          </noise>
        </ray>
        <samples>${int(200000 / float('$(arg lidar_publish_rate)'))}</samples>
        <downsample>1</downsample>
        <visualize>false</visualize>
        <csv_file_name>$(find mid360_simulation)/scan_mode/mid360.csv</csv_file_name>
        <topic>livox/lidar</topic>
      </plugin>
    </sensor>
  </gazebo>
  <!-- Navigation base_link is a ground reference. Official body coordinates stay in go2w_body. -->
  <link name="base_link" />
  <joint name="go2w_body_joint" type="fixed">
    <parent link="base_link" />
    <child link="go2w_body" />
    <origin xyz="0 0 0.43582611" rpy="0 0 0" />
  </joint>
</robot>
